# --- Public site configuration (build time) ---
# Canonical production URL (https, no path, no trailing slash). Used for canonical links, sitemap, Open Graph.
# REQUIRED for production: a Vercel production build now STOPS if this is missing, a placeholder (.example, .test, localhost) or not https.
VITE_SITE_URL=

# Contact details. Leave blank until real, verified details exist; the site hides empty fields.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_ADDRESS=
VITE_LEGAL_ENTITY_NAME=
# Defaults to https://www.instagram.com/kaayra.herbals?srtk=MXc4aXA3YmsycWRldg== (leave EMPTY to use it; an old value here overrides the default)
VITE_INSTAGRAM_URL=

# --- Server only (set in Vercel Project Settings, never prefix with VITE_) ---
# Supabase project URL and SERVICE ROLE key. The service role key bypasses row-level security.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase publishable (anon) key. Used only by the server to check admin passwords.
SUPABASE_ANON_KEY=

# Admin panel: comma-separated list of the ONLY email addresses allowed to use /admin.
ADMIN_EMAILS=
# Random secret (32+ chars) that signs admin sessions. Generate: openssl rand -base64 48
ADMIN_SESSION_SECRET=
# Roles, as email:role pairs (owner, manager, support). REQUIRED: if unset or invalid, nobody can use /admin (no one is made an owner by default).
# Every admin email should be listed; at least one must be an owner. Unlisted ADMIN_EMAILS addresses become support.
# Example: ADMIN_ROLES=boss@kaayra.in:owner,ops@kaayra.in:manager,help@kaayra.in:support
ADMIN_ROLES=
# Two-step verification (authenticator app) for admins. required (default) or optional.
ADMIN_MFA=required
# Key (32+ chars) that encrypts authenticator secrets in the database. Generate: openssl rand -base64 32
# Keep it separate from ADMIN_SESSION_SECRET and never change it casually: changing it makes every enrolled authenticator unreadable.
ADMIN_MFA_KEY=

# Optional: extra allowed origins for the form/admin endpoints (defaults to same-origin only).
ALLOWED_ORIGINS=

# --- OAuth sign-in (server only) ---
# Canonical production URL used for the OAuth redirect. REQUIRED in production (falls back to VITE_SITE_URL).
SITE_URL=
# Google is always shown on sign-in and sign-up. Add github and/or azure here to offer them as well (comma-separated).
# Every provider shown must be enabled in Supabase > Authentication > Providers. Email + password is always on.
OAUTH_PROVIDERS=google
# open (default) lets new members register; closed = existing members and admins only.
MEMBER_SIGNUP=open

# --- Razorpay payments (server only; see docs/RAZORPAY_SETUP.md) ---
# Start with TEST keys (rzp_test_...). Live keys (rzp_live_...) only after written business approval and the go-live review.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type into Razorpay Dashboard > Webhooks (12+ characters). Different from the API key secret. Generate: openssl rand -base64 24
RAZORPAY_WEBHOOK_SECRET=
# Shared secret (16+ chars) a scheduler sends as "Authorization: Bearer <value>" to /api/checkout/reconcile. That call settles late payments
# and releases stock held by unpaid orders. Without it the endpoint answers 404 and unpaid stock is released only when someone checks out
# or an admin acts. Generate: openssl rand -base64 32. Not a Razorpay value.
CRON_SECRET=

# --- Email (Resend; server only; see docs/EMAIL_SETUP.md) ---
# Nothing is sent until RESEND_API_KEY is set. Sign-up and password-reset mails are separate: they go through Supabase SMTP.
RESEND_API_KEY=
# The sender must be on the domain you verified in Resend. Default: Kaayra Herbals <no-reply@kaayraherbals.com>
MAIL_FROM=
# Where internal notifications (new message, new problem report) go. Default: the first address in ADMIN_EMAILS.
MAIL_OWNER_TO=
# Reply-To on mails sent to visitors. Default: MAIL_OWNER_TO.
MAIL_REPLY_TO=
# Set to off to stop the automatic receipt sent to people who use the contact form.
MAIL_AUTOREPLY=on

# --- Launch list (double opt-in) ---
# Random secret (32+ chars) that signs the confirm and unsubscribe links in emails. Generate: openssl rand -base64 48
# Keep it separate from every other secret. Changing it invalidates links already sent (confirm links stop working; unsubscribe links
# in old emails stop working too, so change it only if it leaks). Until it is set, SITE_URL (or VITE_SITE_URL) is a real https address and
# RESEND_API_KEY is set, the launch-list form stays closed and stores nothing.
SUBSCRIBE_TOKEN_SECRET=

# --- Commerce development flags (Phase 5) ---
# Every flag is OFF unless set to on. Each is forced OFF when VERCEL_ENV=production, whatever you set here.
# None of them can open real sales: COMMERCE_ENABLED in shared/commerce.ts stays false until the business approves.
# Set these only in a staging or preview environment.
FEATURE_CART_PREVIEW=
FEATURE_CHECKOUT_TESTING=
# Needs FEATURE_CHECKOUT_TESTING and FEATURE_CART_PREVIEW too, and a Razorpay TEST key (rzp_test_...). A live key is refused while COMMERCE_ENABLED is false.
FEATURE_PAYMENT_TEST_MODE=
FEATURE_SHIPPING_INTEGRATION=
FEATURE_CUSTOMER_ORDER_HISTORY=

# Shared rate limiting (Phase 7 Step 2). Optional salt for hashing IPs/emails before they reach the database; falls back to ADMIN_SESSION_SECRET.
RATE_LIMIT_SALT=
# Set to off to use only the per-instance in-memory limit (for example if supabase/rate_limits.sql has not been run yet).
RATE_LIMIT_SHARED=

# Emergency only (Phase 7 Step 2.5). If the shared rate-limit database is down and an owner must sign in, set this to an ISO time at
# most 60 minutes in the future (for example 2026-10-21T09:30:00Z) and redeploy. It expires by itself; a time further ahead is ignored.
RATE_LIMIT_BREAKGLASS_UNTIL=

# --- Production live-sales approval (server only; read only in production; NEVER set on staging/preview) ---
# COMMERCE_ENABLED is true in code, but real purchases in production stay closed until ALL THREE are set.
# Leave blank until the owner explicitly approves live sales and staging integration tests have passed.
LIVE_SALES_APPROVED=
LIVE_SALES_APPROVED_BY=
LIVE_SALES_APPROVAL_REF=

# --- Cart recovery (Phase 7; see docs/PHASE7_CART_RECOVERY.md) ---
# No new variables are needed. Recovery REUSES: RESEND_API_KEY and MAIL_FROM (sending), SUBSCRIBE_TOKEN_SECRET (signs the unsubscribe links; 32+ chars),
# SITE_URL or VITE_SITE_URL (a real https address for links), CRON_SECRET (the scheduler call), VITE_LEGAL_ENTITY_NAME and VITE_CONTACT_ADDRESS
# (the sender line in every reminder; left out if blank, but fill them in before turning recovery on).
# Recovery ships OFF: the owner switches it on in Admin > Shop > Cart recovery after supabase/cart_recovery.sql has been run.
# With RESEND_API_KEY, SUBSCRIBE_TOKEN_SECRET or a real https site address missing, recovery sends nothing and opens nothing.

# --- SEO audit follow-up (all optional; see docs/SEO_AUDIT_FIXES.md) ---
# Other official profiles. Leave blank until the profile exists; each is then linked in the footer and listed in structured data. https only.
VITE_FACEBOOK_URL=
VITE_X_URL=
VITE_LINKEDIN_URL=
VITE_YOUTUBE_URL=
# Set to true AFTER enabling Web Analytics in the Vercel project (cookie-less, same-origin script). Build-time.
VITE_VERCEL_ANALYTICS=

# --- Gemini AI: Kaayra AI (customers) and Kaayra Intelligence (owner). See docs/PHASE13_GEMINI_AI.md ---
# Ships OFF. Server-only: NEVER give any of these a VITE_ name (VITE_ values are copied into the public website).
# A Google AI Pro subscription is NOT an API key and does not pay for API calls: create a key at https://aistudio.google.com/apikey (free tier first).
# Run supabase/ai.sql (file #30) before switching on; until then AI stays paused to protect your budget.
AI_ENABLED=
GEMINI_API_KEY=
# Optional. Default gemini-3.1-flash-lite. Retired families (gemini-1.x, 2.0, 2.5) are refused. Check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=
# Requests per day for the whole site (default 200). Visitors may use 80%, owner tools keep the rest (min 20).
AI_DAILY_REQUEST_LIMIT=
# Output cap per answer, 128 to 4096 (default 1024). Gemini "thinking" tokens count toward your bill.
AI_MAX_OUTPUT_TOKENS=
# Speed: the customer assistant already asks for the lowest thinking level, a 700 token cap and a 15 second deadline, and the owner tools use "low". Setting AI_THINKING_LEVEL overrides the level everywhere (leave it empty for the fast defaults).
# Optional: AI_TIMEOUT_MS (default 20000, an upper limit), AI_THINKING_LEVEL (minimal|low|medium|high), AI_PRICE_INPUT_PER_M and AI_PRICE_OUTPUT_PER_M (US$ per million tokens, only for the cost estimate)
# Optional: comma-separated admin emails (already in ADMIN_EMAILS) allowed to use Kaayra Intelligence besides owners. They still only see what their own role can read; revenue and profit stay owner-only.
# --- Backup AI providers: currently OFF (Gemini only). Set AI_BACKUPS=on to bring Groq and Claude back as fallbacks; their keys are ignored until then. ---
AI_BACKUPS=
# Order tried (default gemini,groq,anthropic). Providers without a key are skipped. At least one key is needed. Keys are server only: never give them a VITE_ name.
AI_PROVIDER_ORDER=
# Groq has a free tier (https://console.groq.com). Default model llama-3.3-70b-versatile; Groq retires models from time to time, so check their list if calls fail.
GROQ_API_KEY=
GROQ_MODEL=
# Claude API (https://console.anthropic.com). As far as I know the Claude API has no free tier and is paid from credits: check your account. Default model claude-haiku-5-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_INTELLIGENCE_EMAILS=
